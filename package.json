{
  "name": "frame",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:studio": "npm run dev -w @frame/studio",
    "dev:mobile": "npm run dev -w @frame/mobile",
    "build:studio": "npm run build -w @frame/studio",
    "build:mobile": "npm run build -w @frame/mobile",
    "desktop": "npm run desktop -w @frame/studio",
    "android": "npm run android -w @frame/mobile",
    "package:win": "npm run package:win -w @frame/studio",
    "package:installer": "npm run package:installer -w @frame/studio"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "lucide-react": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
